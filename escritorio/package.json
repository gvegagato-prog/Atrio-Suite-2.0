{
  "name": "atrio",
  "productName": "Atrio",
  "version": "3.0.0",
  "description": "Atrio: tus juegos en el PC (Linux, Windows y macOS), tus obras escritas y el móvil",
  "main": "src/main/main.js",
  "author": "Gonzalo",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux AppImage",
    "dist:win": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac dir --arm64"
  },
  "build": {
    "appId": "es.gonzalo.atrio",
    "productName": "Atrio",
    "files": [
      "src/**/*",
      "package.json",
      "!src/**/*.md"
    ],
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Game",
      "icon": "build/icon.png",
      "artifactName": "Atrio-${version}-x86_64.AppImage",
      "executableName": "atrio",
      "desktop": {
        "entry": {
          "Name": "Atrio",
          "Comment": "Launcher minimalista para tus juegos",
          "Categories": "Game;"
        }
      },
      "syncDesktopName": true
    },
    "electronVersion": "44.7.0",
    "publish": null,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Atrio-${version}-Instalador.${ext}",
      "executableName": "Atrio"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Atrio",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "category": "public.app-category.games",
      "icon": "build/icon-mac.png",
      "identity": "-",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSScreenCaptureDescription": "Atrio hace capturas de tus juegos (a tamaño real) cuando las pides desde el móvil.",
        "NSAppleEventsUsageDescription": "Atrio puede apagar, reiniciar o suspender el equipo si lo pides desde el móvil."
      }
    },
    "extraResources": [
      {
        "from": "../movil/app/src/main/assets/sinonimos",
        "to": "sinonimos",
        "filter": [
          "th_es_v2.dat",
          "COPYING",
          "LEEME.txt"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  },
  "desktopName": "atrio.desktop"
}
