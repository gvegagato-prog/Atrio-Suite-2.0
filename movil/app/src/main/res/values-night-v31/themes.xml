<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+: el arranque sin el icono de la app (solo el papel), también al abrir desde un widget -->
    <style name="Ronron" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowSplashScreenBackground">@color/paper</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/arranque_vacio</item>
    </style>
</resources>
