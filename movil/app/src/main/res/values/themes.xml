<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Fondo del arranque igual que el papel de la app, para que no haya destello. -->
    <style name="Ronron" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <color name="paper">#F4F2ED</color>
    <!-- El lector: sin la pantalla de espera gris de Android al abrirlo (la ventana sale ya con el fondo del tema) -->
    <style name="Lector" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
